# ===========================================
# FutuOpenD Docker 环境配置文件
# ===========================================

# ------------------
# FutuOpenD 配置
# ------------------
# 是否启用 RSA 加密通信 (true/false)
# true: 启用，需配合 FUTU_PRIVATE_KEY 填写私钥路径
# false: 不启用，FUTU_PRIVATE_KEY 可留空或指向任意已存在文件
RSA_ENCRYPT_ENABLE=true
# 富途私钥文件路径（宿主机路径，仅 RSA_ENCRYPT_ENABLE=true 时生效）
#
# 【如何生成 .futu_private_key.pem】
# 步骤一：在项目根目录执行以下命令，生成 RSA 1024位 私钥（PKCS#8 格式）：
#
#   openssl genrsa 1024 | openssl pkcs8 -topk8 -nocrypt -out .futu_private_key.pem
#
# 步骤二：将 RSA_ENCRYPT_ENABLE 改为 true，FUTU_PRIVATE_KEY 指向上述私钥文件路径。
#
# 步骤三：在 API 客户端侧也使用同一份私钥文件，SDK 初始化时传入，例如：
#           futu.SysConfig.enable_proto_encrypt(".futu_private_key.pem")
#         OpenD 和 API 客户端共用同一私钥，SDK 会自行推导公钥完成加密握手。
#
# 注意：私钥文件请勿提交到版本控制系统（已在 .gitignore 中排除）。
FUTU_PRIVATE_KEY=./.futu_private_key.pem
# 富途登录账号
FUTU_LOGIN_ACCOUNT=
# 富途登录密码 (MD5加密后的密码)
FUTU_LOGIN_PWD=
# OpenD 监听 IP (0.0.0.0 表示监听所有网卡)
FUTU_OPEND_IP=0.0.0.0
# OpenD 监听端口 (默认 11111)
FUTU_OPEND_PORT=11111
# Telnet 监听 IP (0.0.0.0 表示监听所有网卡)
FUTU_TELNET_IP=0.0.0.0
# Telnet 端口（用于发送短信验证码，默认 22222）
FUTU_TELNET_PORT=22222
# 自动持有高级权限 (0: 否, 1: 是）
# OpenD 在行情权限被抢后，会自动抢回。如果 10 秒内再次被抢，则其他终端获得最高行情权限，OpenD 不会再抢
AUTO_HOLD_QUOTE_RIGHT=1

# ------------------
# Docker 配置
# ------------------
# 容器名称
CONTAINER_NAME=futu-opend
# 镜像名称
IMAGE_NAME=futu-opend
# 镜像标签
IMAGE_TAG=latest

# ------------------
# 重启策略
# ------------------
# always: 总是重启
# unless-stopped: 除非手动停止否则重启
# on-failure: 失败时重启
RESTART_POLICY=unless-stopped

# ------------------
# 网络配置
# ------------------
# Docker 网络名称
NETWORK_NAME=futu-network
